filetype  plugin on
filetype indent on

syntax enable

set autoread

set so=7

" No annoying sound on errors
set noerrorbells
set novisualbell
set t_vb=
set tm=500

" searching
set ignorecase
set hlsearch
set incsearch

" Use spaces instead of tabs
set expandtab

" Be smart when using tabs ;)
set smarttab

" 1 tab == 4 spaces
set shiftwidth=4
set tabstop=4

" Linebreak on 500 characters
set lbr
set tw=500

set ai "Auto indent
set si "Smart indent
set wrap "Wrap lines

" Smart way to move between windows
map <C-j> <C-W>j
map <C-k> <C-W>k
map <C-h> <C-W>h
map <C-l> <C-W>l
